# Copia este archivo como referencia de qué variables configurar en Railway
# (Settings → Variables). NO subas un .env real con contraseñas al repositorio.

# Seguridad
SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui
DEBUG=False
ALLOWED_HOSTS=tuapp.up.railway.app

# Base de datos — Railway la genera solo si agregas el plugin de Postgres
# (no la escribas a mano, Railway la inyecta automáticamente)
# DATABASE_URL=postgresql://...

# Frontend (Vercel) — para los links dentro de los correos y CORS
FRONTEND_URL=https://tuapp.vercel.app
CORS_ALLOWED_ORIGINS=https://tuapp.vercel.app

# backend/.env — SOLO para tu máquina local. Este archivo NUNCA se sube a git
# (ya está en .gitignore). En Railway estas mismas variables se configuran
# aparte, en el panel Settings → Variables.

# Correo — la cuenta de Gmail que ENVÍA los correos
EMAIL_HOST_USER=tallerdiesel847@gmail.com
EMAIL_HOST_PASSWORD=PON_AQUI_TU_CONTRASEÑA_DE_APLICACION_SIN_ESPACIOS
DEFAULT_FROM_EMAIL=TallerDiesel <tallerdiesel847@gmail.com>

# Correo — el buzón que RECIBE copia de los avisos (puede ser distinto al de arriba)
EMAIL_EMPRESA=coordinador@tallerdiesel.com

# URL del frontend en tu máquina (para los links dentro de los correos)
FRONTEND_URL=http://localhost:5173
